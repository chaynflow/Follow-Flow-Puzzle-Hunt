<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>仪表板 - Follow-Flow Puzzle Hunt</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .logout { color: #dc3545; text-decoration: none; }
    .admin-link { color: #007bff; text-decoration: none; margin-right: 15px; }
    .puzzle-form { background: #f8f9fa; padding: 20px; margin-bottom: 30px; border-radius: 5px; }
    .puzzle-form input, .puzzle-form textarea { width: 100%; padding: 8px; margin: 8px 0; box-sizing: border-box; }
    .puzzle-form button { padding: 10px 20px; background: #28a745; color: white; border: none; cursor: pointer; }
    .puzzle-list { list-style: none; padding: 0; }
    .puzzle-item { background: #f1f1f1; padding: 15px; margin-bottom: 10px; border-radius: 5px; }
    .detail-link { display: inline-block; margin-top: 8px; color: #007bff; text-decoration: none; }
    .delete-form { display: inline-block; margin-left: 10px; }
    .toggle-form { display: inline-block; margin-left: 10px; }
    .delete-form button, .toggle-form button { background: #dc3545; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px; }
    .toggle-form button { background: #ffc107; color: #212529; }
    .badge { background: #6c757d; color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.8em; margin-left: 5px; }
    .item-actions { margin-top: 10px; }
    .puzzle-title { font-size: 1.2em; font-weight: bold; margin-bottom: 5px; }
    .visibility-label { font-size: 0.9em; margin-left: 10px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>欢迎, <%= username %>!</h1>
    <div>
      <% if (isRoot) { %>
        <a href="/admin/users" class="admin-link">用户管理</a>
      <% } %>
      <a href="/logout" class="logout">登出</a>
    </div>
  </div>

  <% if (isRoot) { %>
  <div class="puzzle-form">
    <h2>添加新谜题</h2>
    <form action="/puzzles" method="POST" id="puzzleForm">
      <div>
        <label>题目名称（必填）</label>
        <input type="text" name="name" required>
      </div>
      <div>
        <label>标签（可选，多个用逗号分隔）</label>
        <input type="text" name="tags">
      </div>
      <div>
        <label>风味文本（可选，显示在标题后）</label>
        <textarea name="flavor_text" rows="2" placeholder="例如：这是谜题的风味文本"></textarea>
      </div>
      <div>
        <label>文字题面</label>
        <textarea name="description" rows="3"></textarea>
      </div>
      <div>
        <label>答案（必填）</label>
        <input type="text" name="answer" required>
      </div>
      <div>
        <label>
          <input type="checkbox" name="is_visible" checked> 可见（普通用户可以看到）
        </label>
      </div>

      <!-- 中间答案动态区域 -->
      <div>
        <label>中间答案及对应信息（可选，可添加多个）</label>
        <div id="intermediateContainer">
          <div class="intermediate-row" style="margin-bottom:5px;">
            <input type="text" name="inter_answers[]" placeholder="中间答案" style="width:45%; display:inline-block;">
            <input type="text" name="inter_infos[]" placeholder="对应信息（可选）" style="width:45%; display:inline-block;">
            <button type="button" class="remove-intermediate" style="background:#dc3545; color:white; border:none; padding:5px; cursor:pointer;">删除</button>
          </div>
        </div>
        <button type="button" id="addIntermediate" style="background:#007bff; color:white; border:none; padding:5px 10px; cursor:pointer; margin-top:5px;">添加中间答案</button>
      </div>

      <!-- 提示动态区域 -->
      <div>
        <label>提示（可选，可添加多个，包含标题和内容）</label>
        <div id="hintContainer">
          <div class="hint-row" style="margin-bottom:5px;">
            <input type="text" name="hint_titles[]" placeholder="提示标题（例如：我毫无头绪）" style="width:30%; display:inline-block; margin-right:5px;">
            <input type="text" name="hint_texts[]" placeholder="提示内容" style="width:55%; display:inline-block;">
            <button type="button" class="remove-hint" style="background:#dc3545; color:white; border:none; padding:5px; cursor:pointer;">删除</button>
          </div>
        </div>
        <button type="button" id="addHint" style="background:#007bff; color:white; border:none; padding:5px 10px; cursor:pointer; margin-top:5px;">添加提示</button>
      </div>

      <button type="submit" style="margin-top:15px;">添加谜题</button>
    </form>
  </div>
  <% } %>

  <h2>所有谜题</h2>
  <% if (puzzles.length === 0) { %>
    <p>暂无谜题。</p>
  <% } else { %>
    <ul class="puzzle-list">
      <% puzzles.forEach(puzzle => { %>
        <li class="puzzle-item">
          <div class="puzzle-title">
            <% if (puzzle.tags) { %>
              【<%= puzzle.tags %>】
            <% } %>
            <%= puzzle.name %>
            <% if (isRoot) { %>
              <span class="visibility-label">
                [<%= puzzle.is_visible ? '可见' : '隐藏' %>]
              </span>
            <% } %>
          </div>
          <% if (isRoot) { %>
            <p>
              <strong>中间答案数：</strong> <%= puzzle.inter_count %>
              <strong>提示数：</strong> <%= puzzle.hint_count %>
            </p>
            <small>创建时间：<%= puzzle.created_at %></small>
            <div class="item-actions">
              <a href="/puzzles/<%= puzzle.id %>" class="detail-link">查看详情</a>
              <form action="/puzzles/<%= puzzle.id %>/toggle-visibility" method="POST" class="toggle-form" onsubmit="return confirm('确定要切换该题目的可见性吗？');">
                <button type="submit"><%= puzzle.is_visible ? '隐藏' : '显示' %></button>
              </form>
              <form action="/puzzles/<%= puzzle.id %>/delete" method="POST" class="delete-form" onsubmit="return confirm('确定要删除这个谜题吗？此操作不可逆。');">
                <button type="submit">删除谜题</button>
              </form>
            </div>
          <% } else { %>
            <small>创建时间：<%= puzzle.created_at %></small>
            <div class="item-actions">
              <a href="/puzzles/<%= puzzle.id %>" class="detail-link">查看详情 & 提交答案</a>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <% if (isRoot) { %>
  <script>
    // 动态添加中间答案行
    document.getElementById('addIntermediate').addEventListener('click', function() {
      const container = document.getElementById('intermediateContainer');
      const row = document.createElement('div');
      row.className = 'intermediate-row';
      row.style.marginBottom = '5px';
      row.innerHTML = `
        <input type="text" name="inter_answers[]" placeholder="中间答案" style="width:45%; display:inline-block;">
        <input type="text" name="inter_infos[]" placeholder="对应信息（可选）" style="width:45%; display:inline-block;">
        <button type="button" class="remove-intermediate" style="background:#dc3545; color:white; border:none; padding:5px; cursor:pointer;">删除</button>
      `;
      container.appendChild(row);
      attachRemoveHandlers();
    });

    // 动态添加提示行
    document.getElementById('addHint').addEventListener('click', function() {
      const container = document.getElementById('hintContainer');
      const row = document.createElement('div');
      row.className = 'hint-row';
      row.style.marginBottom = '5px';
      row.innerHTML = `
        <input type="text" name="hint_titles[]" placeholder="提示标题（例如：我毫无头绪）" style="width:30%; display:inline-block; margin-right:5px;">
        <input type="text" name="hint_texts[]" placeholder="提示内容" style="width:55%; display:inline-block;">
        <button type="button" class="remove-hint" style="background:#dc3545; color:white; border:none; padding:5px; cursor:pointer;">删除</button>
      `;
      container.appendChild(row);
      attachRemoveHandlers();
    });

    // 绑定删除事件
    function attachRemoveHandlers() {
      document.querySelectorAll('.remove-intermediate').forEach(btn => {
        btn.onclick = function() { this.parentElement.remove(); };
      });
      document.querySelectorAll('.remove-hint').forEach(btn => {
        btn.onclick = function() { this.parentElement.remove(); };
      });
    }

    // 初始绑定已有行
    attachRemoveHandlers();
  </script>
  <% } %>
</body>
</html>