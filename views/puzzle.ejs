<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>谜题详情 - Follow-Flow Puzzle Hunt</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 30px auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .back-link { color: #007bff; text-decoration: none; }
    .puzzle-card { background: #f8f9fa; padding: 25px; border-radius: 8px; }
    .puzzle-title { font-size: 1.5em; font-weight: bold; margin-bottom: 10px; }
    .flavor-text { font-style: italic; color: #555; margin: 5px 0; white-space: pre-line; }
    .description-text { white-space: pre-line; margin: 10px 0; }
    .description-text img { max-width: 100%; height: auto; display: block; margin: 10px 0; }
    .flavor-text img { max-width: 100%; height: auto; }
    .hint-points-box { background: #e9f7ef; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
    .answer-form { margin-top: 25px; }
    .answer-form input { width: 100%; padding: 10px; margin-bottom: 10px; box-sizing: border-box; }
    .answer-form button { padding: 10px 20px; background: #28a745; color: white; border: none; cursor: pointer; }
    .result { padding: 12px; margin: 20px 0; border-radius: 5px; font-weight: bold; }
    .result.correct { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .result.incorrect { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .result.intermediate { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .result.no_attempts { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .hint-section { margin: 15px 0; }
    .hint-item { margin-bottom: 10px; }
    .hint-content { background: #fff3cd; padding: 10px; border-radius: 5px; margin-top: 5px; white-space: pre-line; }
    .hint-content img { max-width: 100%; height: auto; }
    .hint-toggle-btn { background: #ffc107; color: #212529; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px; }
    .hint-unlocked { background: #e9ecef; padding: 10px; border-radius: 5px; margin-top: 5px; }
    .admin-answer { background: #e9ecef; padding: 10px; border-radius: 5px; margin-top: 10px; }
    .admin-intermediate { white-space: pre-line; }
    .edit-link { color: #007bff; text-decoration: none; margin-left: 10px; }
    .error-msg { color: red; margin-bottom: 10px; }
    .attempt-info {
      background: #fff8e1;
      border: 1px solid #f0c674;
      padding: 10px 14px;
      border-radius: 5px;
      margin: 15px 0;
    }
    .attempt-info .buy-btn {
      background: #007bff;
      color: white;
      border: none;
      padding: 5px 12px;
      cursor: pointer;
      border-radius: 3px;
      margin-left: 10px;
    }
    .inbox-box {
      background: #eef4ff;
      border: 1px solid #b6ccf5;
      padding: 14px;
      border-radius: 8px;
      margin: 20px 0;
    }
    .inbox-box h3 { margin-top: 0; }
    .inbox-thread { max-height: 320px; overflow-y: auto; margin: 10px 0; }
    .inbox-msg { padding: 8px 10px; border-radius: 6px; margin-bottom: 8px; white-space: pre-wrap; word-break: break-word; }
    .inbox-msg.user { background: white; border: 1px solid #d0d7e2; }
    .inbox-msg.staff { background: #fff8e1; border: 1px solid #f0c674; }
    .inbox-msg .meta { font-size: 0.8em; color: #666; display: block; margin-bottom: 4px; }
    .inbox-status { padding: 8px 10px; border-radius: 5px; margin: 8px 0; font-size: 0.95em; }
    .inbox-status.waiting { background: #fff3cd; color: #856404; }
    .inbox-status.locked { background: #f8d7da; color: #721c24; }
    .inbox-box textarea { width: 100%; box-sizing: border-box; padding: 8px; min-height: 70px; font-family: inherit; }
    .inbox-box .send-btn { background: #007bff; color: white; border: none; padding: 8px 16px; cursor: pointer; border-radius: 4px; margin-top: 6px; }
    .inbox-box .cost-hint { font-size: 0.9em; color: #555; margin: 6px 0; }
  </style>
</head>
<body>
  <div class="header">
    <h1>谜题详情</h1>
    <% if (competitionId) { %>
      <a href="/competitions/<%= competitionId %>" class="back-link">&larr; 返回比赛</a>
    <% } else { %>
      <a href="/dashboard" class="back-link">&larr; 返回仪表板</a>
    <% } %>
  </div>

  <div class="puzzle-card">
    <% if (canViewPuzzle) { %>
      <% if (hintPoints !== null && hintPoints !== undefined) { %>
        <div class="hint-points-box">
          <strong>当前提示点：</strong> <span id="hintPointsDisplay"><%= Math.floor(hintPoints) %></span>
        </div>
      <% } %>
      <% if (hint_error) { %>
        <div class="error-msg">提示点不足，无法打开该提示。</div>
      <% } %>

      <div class="puzzle-title">
        <% if (puzzle.tags) { %>
          【<%= puzzle.tags %>】
        <% } %>
        <%= puzzle.name %>
      </div>

      <% if (flavorTextHtml) { %>
        <p class="flavor-text"><em><%- flavorTextHtml %></em></p>
      <% } %>

      <% if (descriptionHtml) { %>
        <h3>题面</h3>
        <p class="description-text"><%- descriptionHtml %></p>
      <% } %>

      <% if (isStaff) { %>
        <div class="admin-answer">
          <h3>管理信息（仅 staff 可见）
            <a href="/puzzles/<%= puzzle.id %>/edit" class="edit-link">编辑</a>
          </h3>
          <p><strong>答案：</strong> <%= puzzle.answer %></p>
          <p><strong>可见性：</strong> <%= puzzle.is_visible ? '可见' : '隐藏' %></p>
          <% if (intermediateAnswers.length > 0) { %>
            <p><strong>中间答案：</strong></p>
            <ul class="admin-intermediate">
              <% intermediateAnswers.forEach(ia => { %>
                <li><%= ia.answer %> <% if (ia.info) { %> - <%= ia.info %><% } %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% } %>

      <!-- 提示区域 -->
      <% if (hints.length > 0) { %>
        <div class="hint-section">
          <h3>提示</h3>
          <% hints.forEach((hint, index) => {
             const isUnlocked = hintUnlocks && hintUnlocks.includes(hint.id);
          %>
            <div class="hint-item">
              <% if (competitionId && !isStaff && !isUnlocked) { %>
                <!-- 未解锁，消耗提示点 -->
                <form action="/puzzles/<%= puzzle.id %>/hints/<%= hint.id %>/unlock" method="POST" onsubmit="return confirm('消耗 <%= hint.effective_cost %> 提示点打开该提示？');">
                  <input type="hidden" name="competition_id" value="<%= competitionId %>">
                  <button type="submit" class="hint-toggle-btn">
                    消耗 <%= hint.effective_cost %> 点显示提示<%= index + 1 %><% if (hint.title) { %>：<%= hint.title %><% } %>
                  </button>
                </form>
              <% } else if (isUnlocked) { %>
                <!-- 已解锁：直接显示内容 -->
                <div class="hint-unlocked">
                  <strong><%= hint.title || '提示' %>：</strong>
                  <div class="hint-content" style="margin-top:5px;">
                    <%- hint.hint_text_html %>
                  </div>
                </div>
              <% } else { %>
                <!-- 非比赛模式或 staff：可显示/隐藏 -->
                <button class="hint-toggle-btn"
                        data-hint-id="hint-<%= hint.id %>"
                        data-title="<%= hint.title || '' %>"
                        data-index="<%= index + 1 %>">
                  显示提示<%= index + 1 %><% if (hint.title) { %>：<%= hint.title %><% } %>
                </button>
                <div class="hint-content" id="hint-<%= hint.id %>" style="display:none;">
                  <strong><%= hint.title || '提示' %>：</strong> <%- hint.hint_text_html %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- 答案提交区 -->
      <div class="answer-form">
        <h3>提交你的答案</h3>

        <% if (typeof attemptInfo !== 'undefined' && attemptInfo) { %>
          <div class="attempt-info">
            <strong>剩余提交次数：</strong>
            <%= attemptInfo.remaining %> / <%= attemptInfo.max_attempts + attemptInfo.extra_attempts %>
            <% if (attemptInfo.remaining === 0 && attemptInfo.refill_cost > 0) { %>
              <form action="/puzzles/<%= puzzle.id %>/attempts/buy" method="POST" style="display:inline-block;">
                <input type="hidden" name="competition_id" value="<%= competitionId %>">
                <button type="submit" class="buy-btn"
                        onclick="return confirm('确认使用 <%= attemptInfo.refill_cost %> 提示点购买 <%= attemptInfo.max_attempts %> 次提交机会？');">
                  用 <%= attemptInfo.refill_cost %> 提示点购买 <%= attemptInfo.max_attempts %> 次
                </button>
              </form>
            <% } %>
          </div>
        <% } %>

        <% if (result === 'correct') { %>
          <div class="result correct">✅ 回答正确！</div>
        <% } else if (result === 'intermediate') { %>
          <% if (intermediateInfo) { %>
            <div class="result intermediate"><%= intermediateInfo %></div>
          <% } %>
        <% } else if (result === 'incorrect') { %>
          <div class="result incorrect">❌ 回答错误，请再试一次。</div>
        <% } else if (result === 'no_attempts') { %>
          <div class="result no_attempts">⛔ 本题提交次数已用尽，请先购买更多提交机会。</div>
        <% } %>

        <form action="/puzzles/<%= puzzle.id %>/answer" method="POST">
          <input type="text" name="answer" placeholder="输入答案" required>
          <% if (typeof competitionId !== 'undefined' && competitionId) { %>
            <input type="hidden" name="competition_id" value="<%= competitionId %>">
          <% } %>
          <button type="submit">提交答案</button>
        </form>
      </div>
    <% } else { %>
      <p>谜题不存在或已隐藏。</p>
    <% } %>

    <% if (typeof inboxInfo !== 'undefined' && inboxInfo && inboxInfo.enabled) { %>
      <% const ib = inboxInfo; %>
      <div class="inbox-box">
        <h3>📨 站内信（仅针对本题）</h3>
        <% if (inboxError) { %>
          <div class="error-msg">提示点不足，无法向管理员发起询问。</div>
        <% } %>

        <% if (ib.messages && ib.messages.length > 0) { %>
          <div class="inbox-thread">
            <% ib.messages.forEach(m => { %>
              <div class="inbox-msg <%= m.sender_role === 'user' ? 'user' : 'staff' %>">
                <span class="meta"><%= m.sender_role === 'user' ? '你' : (m.username || '管理员') %> · <%= m.created_at %></span>
                <%= m.content %>
              </div>
            <% }) %>
          </div>
        <% } %>

        <% if (ib.state === 'pending') { %>
          <div class="inbox-status waiting">⏳ 已发送，等待管理员处理。</div>
        <% } else if (ib.state === 'claimed') { %>
          <div class="inbox-status waiting">👀 管理员正在查看你的问题，请耐心等待回复。</div>
        <% } else if (ib.state === 'replied_locked') { %>
          <div class="inbox-status locked">
            🔒 管理员已回复，回复将在 <strong><%= ib.unlockAt %></strong> 解锁。解锁之前无法追问。
          </div>
        <% } else if (ib.state === 'request_available') { %>
          <div class="cost-hint">向管理员提问需消耗 <strong><%= ib.cost %></strong> 提示点（仅第一次提问收费，解锁后的追问免费）。</div>
          <form action="/puzzles/<%= puzzle.id %>/inbox" method="POST"
                onsubmit="return confirm('确认消耗 <%= ib.cost %> 提示点向管理员发起询问？');">
            <input type="hidden" name="competition_id" value="<%= competitionId %>">
            <textarea name="content" placeholder="描述你遇到的问题或想向管理员询问的内容" required maxlength="5000"></textarea>
            <button type="submit" class="send-btn">发送给管理员</button>
          </form>
        <% } else if (ib.state === 'visible') { %>
          <div class="cost-hint">可以继续追问，无需再消耗提示点。</div>
          <form action="/puzzles/<%= puzzle.id %>/inbox" method="POST">
            <input type="hidden" name="competition_id" value="<%= competitionId %>">
            <textarea name="content" placeholder="追问内容" required maxlength="5000"></textarea>
            <button type="submit" class="send-btn">发送追问</button>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>

  <script>
    // 仅对普通可切换按钮绑定事件
    document.querySelectorAll('.hint-toggle-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const hintId = this.getAttribute('data-hint-id');
        if (hintId) {
          const content = document.getElementById(hintId);
          if (content) {
            if (content.style.display === 'none') {
              content.style.display = 'block';
              this.textContent = '隐藏提示' + this.getAttribute('data-index');
            } else {
              content.style.display = 'none';
              this.textContent = '显示提示' + this.getAttribute('data-index') + (this.getAttribute('data-title') !== '' ? '：' + this.getAttribute('data-title') : '');
            }
          }
        }
      });
    });

    // 动态更新提示点
    const hintPointsElem = document.getElementById('hintPointsDisplay');
    if (hintPointsElem) {
      const compId = <%= competitionId ? competitionId : 'null' %>;
      async function updateHintPoints() {
        try {
          const response = await fetch(`/api/competitions/${compId}/hint-points`);
          if (response.ok) {
            const data = await response.json();
            if (data.hintPoints !== null && data.hintPoints !== undefined) {
              hintPointsElem.textContent = Math.floor(data.hintPoints);
            }
          }
        } catch (err) {
          console.error('更新提示点失败:', err);
        }
      }
      setInterval(updateHintPoints, 30000);
    }

    // 站内信解锁倒计时：到点后自动刷新，让回复出现
    (function () {
      const lockEl = document.querySelector('.inbox-status.locked');
      const unlockAt = <%- typeof inboxInfo !== 'undefined' && inboxInfo && inboxInfo.unlockAt ? JSON.stringify(inboxInfo.unlockAt) : 'null' %>;
      if (lockEl && unlockAt) {
        const target = new Date(unlockAt).getTime();
        const remain = target - Date.now();
        if (remain > 0) {
          setTimeout(() => window.location.reload(), Math.min(remain + 1000, 2147480000));
        }
      }
    })();
  </script>
</body>
</html>