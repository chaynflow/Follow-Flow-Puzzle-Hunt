<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>比赛列表 - Follow-Flow Puzzle Hunt</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 30px auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .back-link { color: #007bff; text-decoration: none; }
    .add-contest { display: inline-block; background: #28a745; color: white; padding: 8px 16px; text-decoration: none; border-radius: 5px; margin-bottom: 20px; }
    .contest-list { list-style: none; padding: 0; }
    .contest-item { background: #f8f9fa; padding: 15px; margin-bottom: 10px; border-radius: 5px; }
    .contest-name { font-size: 1.2em; font-weight: bold; margin-bottom: 5px; }
    .contest-meta { color: #666; font-size: 0.9em; }
    .status-badge { display: inline-block; padding: 3px 8px; border-radius: 3px; font-size: 0.8em; margin-left: 10px; }
    .status-active { background: #d4edda; color: #155724; }
    .status-upcoming { background: #fff3cd; color: #856404; }
    .status-ended { background: #f8d7da; color: #721c24; }
  </style>
</head>
<body>
  <div class="header">
    <h1>比赛</h1>
    <a href="/dashboard" class="back-link">&larr; 返回仪表板</a>
  </div>

  <% if (isStaff) { %>
    <a href="/contests/new" class="add-contest">创建比赛</a>
  <% } %>

  <% if (contests.length === 0) { %>
    <p>暂无比赛。</p>
  <% } else { %>
    <ul class="contest-list">
      <% contests.forEach(contest => { %>
        <li class="contest-item">
          <div class="contest-name">
            <%= contest.name %>
            <span class="status-badge status-<%= contest.status %>">
              <%= contest.status === 'active' ? '进行中' : (contest.status === 'upcoming' ? '未开始' : '已结束') %>
            </span>
          </div>
          <div class="contest-meta">
            开始：<%= contest.start_time %> | 结束：<%= contest.end_time %> |
            题目数：<%= contest.puzzle_count %> | 报名人数：<%= contest.participant_count %>
          </div>
          <div style="margin-top:10px;">
            <a href="/contests/<%= contest.id %>">查看详情</a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>