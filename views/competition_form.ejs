<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEdit ? '编辑比赛' : '创建比赛' %> - Follow-Flow Puzzle Hunt</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 30px auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .back-link { color: #007bff; text-decoration: none; }
    .form-container { background: #f8f9fa; padding: 20px; border-radius: 5px; }
    .form-container input, .form-container textarea, .form-container select { width: 100%; padding: 8px; margin: 8px 0; box-sizing: border-box; }
    .rule-row { border: 1px solid #ccc; padding: 10px; margin-bottom: 10px; border-radius: 5px; background: white; }
    .rule-row input, .rule-row select { display: inline-block; margin-right: 5px; margin-bottom: 5px; }
    .rule-row .remove-btn { background: #dc3545; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px; }
    .add-rule-btn { background: #007bff; color: white; border: none; padding: 8px 15px; cursor: pointer; border-radius: 3px; margin-top: 10px; }
    .form-container button[type="submit"] { margin-top: 15px; background: #28a745; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 3px; }
    .help-text { font-size: 0.85em; color: #666; margin-top: 2px; }
    .rule-row input[name="puzzle_ids[]"] { width: 80px; }
    .rule-row input[name="unlock_ids[]"] { width: 180px; }
    .rule-row input[name="unlock_counts[]"] { width: 80px; }
    .rule-row select[name="is_meta[]"] { width: 90px; }
  </style>
</head>
<body>
  <div class="header">
    <h1><%= isEdit ? '编辑比赛' : '创建新比赛' %></h1>
    <a href="/competitions" class="back-link">&larr; 返回比赛列表</a>
  </div>

  <div class="form-container">
    <form action="<%= isEdit ? `/competitions/${competition.id}/edit` : '/competitions' %>" method="POST" id="competitionForm">
      <div>
        <label>比赛名称（必填）</label>
        <input type="text" name="name" value="<%= competition ? competition.name : '' %>" required>
      </div>
      <div>
        <label>开始时间（必填）</label>
        <input type="datetime-local" name="start_time" value="<%= competition ? competition.start_time.slice(0,16) : '' %>" required>
      </div>
      <div>
        <label>结束时间（必填）</label>
        <input type="datetime-local" name="end_time" value="<%= competition ? competition.end_time.slice(0,16) : '' %>" required>
      </div>
      <div>
        <label>提示点增速（每分钟点数）</label>
        <input type="number" step="0.01" min="0" name="hint_points_per_minute" value="<%= competition ? competition.hint_points_per_minute || 0 : 0 %>">
        <div class="help-text">用户报名后，提示点将按此速率从比赛开始或报名时间（较晚者）开始累积。</div>
      </div>

      <div>
        <label>题目规则（每个规则对应一个题目）</label>
        <div id="rulesContainer">
          <% if (rules.length > 0) { %>
            <% rules.forEach((rule, idx) => { %>
              <div class="rule-row">
                <input type="text" name="puzzle_ids[]" placeholder="题目编号" value="<%= rule.puzzle_id %>" required>
                <input type="text" name="unlock_ids[]" placeholder="前置题目编号（逗号分隔，留空则比赛开始即可见）" value="<%= rule.unlock_puzzle_ids || '' %>">
                <input type="text" name="unlock_counts[]" placeholder="所需完成数量" value="<%= rule.unlock_required_count || '' %>">
                <select name="is_meta[]">
                  <option value="0" <%= rule.is_meta == 0 ? 'selected' : '' %>>普通题</option>
                  <option value="1" <%= rule.is_meta == 1 ? 'selected' : '' %>>Meta题</option>
                </select>
                <button type="button" class="remove-btn">删除</button>
              </div>
            <% }) %>
          <% } else { %>
            <div class="rule-row">
              <input type="text" name="puzzle_ids[]" placeholder="题目编号" required>
              <input type="text" name="unlock_ids[]" placeholder="前置题目编号（逗号分隔，留空则比赛开始即可见）">
              <input type="text" name="unlock_counts[]" placeholder="所需完成数量">
              <select name="is_meta[]">
                <option value="0" selected>普通题</option>
                <option value="1">Meta题</option>
              </select>
              <button type="button" class="remove-btn">删除</button>
            </div>
          <% } %>
        </div>
        <button type="button" id="addRuleBtn" class="add-rule-btn">添加题目规则</button>
        <div class="help-text">每个规则：目标题目ID；前置题目ID（逗号分隔）；需要在前置中完成的数量。留空前置则比赛开始后即可访问。Meta题会在题目名前显示彩色标签。</div>
      </div>

      <button type="submit"><%= isEdit ? '保存修改' : '创建比赛' %></button>
    </form>
  </div>

  <script>
    // 动态添加规则行
    document.getElementById('addRuleBtn').addEventListener('click', function() {
      const container = document.getElementById('rulesContainer');
      const row = document.createElement('div');
      row.className = 'rule-row';
      row.innerHTML = `
        <input type="text" name="puzzle_ids[]" placeholder="题目编号" required>
        <input type="text" name="unlock_ids[]" placeholder="前置题目编号（逗号分隔，留空则比赛开始即可见）">
        <input type="text" name="unlock_counts[]" placeholder="所需完成数量">
        <select name="is_meta[]">
          <option value="0" selected>普通题</option>
          <option value="1">Meta题</option>
        </select>
        <button type="button" class="remove-btn">删除</button>
      `;
      container.appendChild(row);
      attachRemoveHandlers();
    });

    // 绑定删除事件
    function attachRemoveHandlers() {
      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.onclick = function() { this.parentElement.remove(); };
      });
    }

    // 初始绑定
    attachRemoveHandlers();
  </script>
</body>
</html>