<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEdit ? '编辑比赛' : '创建比赛' %> - Follow-Flow Puzzle Hunt</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 30px auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .back-link { color: #007bff; text-decoration: none; }
    .form-container { background: #f8f9fa; padding: 20px; border-radius: 5px; }
    .form-container input, .form-container textarea { width: 100%; padding: 8px; margin: 8px 0; box-sizing: border-box; }
    .form-container button { padding: 10px 20px; background: #28a745; color: white; border: none; cursor: pointer; }
    .puzzle-checkboxes { max-height: 300px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; background: white; }
    .checkbox-item { margin: 5px 0; }
  </style>
</head>
<body>
  <div class="header">
    <h1><%= isEdit ? '编辑比赛' : '创建比赛' %></h1>
    <a href="/contests" class="back-link">&larr; 返回比赛列表</a>
  </div>

  <div class="form-container">
    <form action="<%= isEdit ? `/contests/${contest.id}/edit` : '/contests' %>" method="POST">
      <div>
        <label>比赛名称</label>
        <input type="text" name="name" value="<%= contest ? contest.name : '' %>" required>
      </div>
      <div>
        <label>比赛描述</label>
        <textarea name="description" rows="3"><%= contest ? contest.description : '' %></textarea>
      </div>
      <div>
        <label>开始时间</label>
        <input type="datetime-local" name="start_time" value="<%= contest ? contest.start_time : '' %>" required>
      </div>
      <div>
        <label>结束时间</label>
        <input type="datetime-local" name="end_time" value="<%= contest ? contest.end_time : '' %>" required>
      </div>
      <div>
        <label>选择题目（可多选）</label>
        <div class="puzzle-checkboxes">
          <% puzzles.forEach(puzzle => { %>
            <div class="checkbox-item">
              <input type="checkbox" name="puzzle_ids[]" value="<%= puzzle.id %>" 
                     <%= selectedPuzzleIds.includes(puzzle.id) ? 'checked' : '' %>>
              <label style="display:inline; font-weight:normal;">
                #<%= puzzle.id %> <%= puzzle.name %> 
                <% if (puzzle.is_visible === 0) { %>(隐藏)<% } %>
              </label>
            </div>
          <% }) %>
        </div>
      </div>
      <button type="submit" style="margin-top:10px;"><%= isEdit ? '保存修改' : '创建比赛' %></button>
    </form>
  </div>
</body>
</html>